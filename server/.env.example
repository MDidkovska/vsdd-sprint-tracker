# VSDD Sprint Tracker — local PoC backend environment example.
#
# Copy this file to `.env` and adjust as needed:
#   cp .env.example .env
#
# This is a PROOF-OF-CONCEPT configuration only. It does NOT contain real
# secrets and MUST NOT be used for production. Phase 8 adds LOCAL account
# authentication (email + password with Argon2id, Admin approval and opaque
# server-side sessions). Enterprise OIDC remains a future decision (task 0.2).

# --- HTTP server ---
# Host/port the Fastify server binds to.
HOST=0.0.0.0
PORT=8080

# --- MongoDB (PoC document store) ---
# Connection URI for the local MongoDB started via docker-compose.yml.
# The docker-compose service publishes MongoDB on localhost:27017 with no auth
# (local PoC only). Never expose an unauthenticated MongoDB beyond localhost.
#
# The PoC MongoDB runs as a SINGLE-NODE REPLICA SET (`rs0`). The `replicaSet`
# query parameter is REQUIRED: submit / reopen / leadership-decision operations
# use multi-document transactions, which MongoDB only supports on a replica set.
# Without it the server starts but every transactional write fails.
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
# Logical database name used by the adapter.
MONGO_DB=vsdd_sprint_tracker

# --- Logging ---
# Fastify/pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Local-account authentication (Phase 8) ---
# Whether session cookies are marked `Secure`. Defaults to ON only when
# NODE_ENV=production; leave unset for local http development. MUST be enabled
# outside local development (requirements.md R1.3).
# SECURE_COOKIES=true
#
# Opaque server-side session lifetime, in hours.
SESSION_TTL_HOURS=12
#
# Create the first Admin account interactively (password is never echoed or put
# in shell history):  npm run bootstrap-admin
