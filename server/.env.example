# VSDD Sprint Tracker — local PoC backend environment example.
#
# Copy this file to `.env` and adjust as needed:
#   cp .env.example .env
#
# This is a PROOF-OF-CONCEPT configuration only. It does NOT contain real
# secrets and MUST NOT be used for production. Authentication is intentionally
# absent for the PoC (design.md §4b); enterprise OIDC integration is Phase 8.

# --- HTTP server ---
# Host/port the Fastify server binds to.
HOST=0.0.0.0
PORT=8080

# --- MongoDB (PoC document store) ---
# Connection URI for the local MongoDB started via docker-compose.yml.
# The docker-compose service publishes MongoDB on localhost:27017 with no auth
# (local PoC only). Never expose an unauthenticated MongoDB beyond localhost.
MONGO_URI=mongodb://localhost:27017
# Logical database name used by the adapter.
MONGO_DB=vsdd_sprint_tracker

# --- Logging ---
# Fastify/pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
