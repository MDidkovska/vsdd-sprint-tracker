{
  "name": "vsdd-sprint-tracker-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VSDD Sprint Tracker — local PoC backend (Node.js + TypeScript + Fastify) with a vendor-neutral MongoDB document adapter. Proof of concept only; not a production or PTSB platform commitment (design.md §4b).",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "bootstrap-admin": "tsx --env-file-if-exists=.env src/scripts/bootstrapAdmin.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "fastify": "5.12.1",
    "mongodb": "6.21.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^8.57.0",
    "mongodb-memory-server": "10.4.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
